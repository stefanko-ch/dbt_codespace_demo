{
    "name": "dbt + n8n + Postgres",
    "dockerComposeFile": "docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "hostRequirements": {
        "cpus": 2,
        "memory": "8gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "forwardPorts": [
        5432,
        8080,
        3000
    ],
    "portsAttributes": {
        "5432": {
            "label": "Postgres"
        },
        "8080": {
            "label": "Kestra",
            "onAutoForward": "openPreview"
        },
        "3000": {
            "label": "Metabase"
        }
    },
    "containerEnv": {
        "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/dbt"
    },
    "postCreateCommand": "cd dbt && uv sync && (grep -q 'dbt/.venv/bin/activate' /root/.bashrc || echo \"source ${containerWorkspaceFolder}/dbt/.venv/bin/activate\" >> /root/.bashrc)",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/dbt/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "[sql]": {
                    "editor.defaultFormatter": "innoverio.vscode-dbt-power-user"
                }
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "innoverio.vscode-dbt-power-user",
                "cweijan.vscode-database-client2"
            ]
        }
    }
}
