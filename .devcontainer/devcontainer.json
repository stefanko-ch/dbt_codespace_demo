{
    "name": "dbt + Kestra + Postgres",
    "dockerComposeFile": "docker-compose.yml",
    "service": "workspace",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "hostRequirements": {
        "cpus": 4,
        "memory": "16gb",
        "storage": "32gb"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "forwardPorts": [
        5432,
        8090,
        8080,
        3000,
        8888
    ],
    "portsAttributes": {
        "5432": {
            "label": "Postgres"
        },
        "8090": {
            "label": "Kestra",
            "onAutoForward": "openPreview"
        },
        "8080": {
            "label": "dbt docs"
        },
        "3000": {
            "label": "Metabase"
        },
        "8888": {
            "label": "Jupyter Lab"
        }
    },
    "containerEnv": {
        "DBT_PROFILES_DIR": "${containerWorkspaceFolder}/dbt"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/dbt/.venv/bin/python",
                "python.terminal.activateEnvironment": true,
                "[sql]": {
                    "editor.defaultFormatter": "innoverio.vscode-dbt-power-user"
                },
                "sqltools.connections": [
                    {
                        "name": "analytics (Postgres)",
                        "driver": "PostgreSQL",
                        "server": "postgres",
                        "port": 5432,
                        "database": "analytics",
                        "username": "postgres",
                        "password": "postgres",
                        "askForPassword": false,
                        "previewLimit": 50
                    },
                    {
                        "name": "playground (Postgres)",
                        "driver": "PostgreSQL",
                        "server": "postgres",
                        "port": 5432,
                        "database": "playground",
                        "username": "postgres",
                        "password": "postgres",
                        "askForPassword": false,
                        "previewLimit": 50
                    },
                    {
                        "name": "kestra (Postgres)",
                        "driver": "PostgreSQL",
                        "server": "postgres",
                        "port": 5432,
                        "database": "kestra",
                        "username": "postgres",
                        "password": "postgres",
                        "askForPassword": false,
                        "previewLimit": 50
                    },
                    {
                        "name": "metabase (Postgres)",
                        "driver": "PostgreSQL",
                        "server": "postgres",
                        "port": 5432,
                        "database": "metabase",
                        "username": "postgres",
                        "password": "postgres",
                        "askForPassword": false,
                        "previewLimit": 50
                    }
                ]
            },
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "mechatroner.rainbow-csv",
                "innoverio.vscode-dbt-power-user",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg"
            ]
        }
    }
}
